# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
AI_API_KEY=your_groq_api_key_here

# Optional: Groq model override (default: llama-3.3-70b-versatile)
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# SECURITY NOTE:
# Vite environment variables prefixed with VITE_ or AI_ are exposed to the client browser.
# Direct browser-to-Groq requests are appropriate only for personal and local development.
# For public production deployments, move this request behind a serverless proxy/backend.
