# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
# SERVER-SIDE ONLY (Used by Vercel Serverless Functions and local dev proxy):
GROQ_API_KEY=your_groq_api_key_here

# LEGACY TRANSITION VARIABLES (Do NOT expose in production):
VITE_GROQ_API_KEY=your_groq_api_key_here
AI_API_KEY=your_groq_api_key_here

# Optional: Groq model override (default: openai/gpt-oss-120b or llama-3.3-70b-versatile)
# GROQ_MODEL=openai/gpt-oss-120b

# SECURITY NOTE:
# GROQ_API_KEY is kept strictly on the server (/api/evaluate-answer and /api/groq-chat).
# In production on Vercel, set GROQ_API_KEY in Project Settings -> Environment Variables.

